            "raspberrypi"
        ],
        "interface": "pwm",
        "connection": {
            "pins": [
                {
                    "role": "signal",
                    "required": true,
                    "notes": "50Hz control pulse."
                }
            ],
            "supply_voltage": "5V",
            "level_shift_required": null
        },
        "runtime": {
            "python_module": "drivers.servo",
