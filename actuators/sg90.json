                "adafruit-circuitpython-motor",
                "rpi-lgpio"
            ],
            "apt_packages": [],
            "init": {
                "class": "adafruit_motor.servo.Servo",
                "args": {
                    "pwm_out": "{pwm_channel}",
                    "min_pulse": 500,
                    "max_pulse": 2400
                }
            }
        },
        "constraints": {
            "min_read_interval_seconds": null,
            "read_timeout_seconds": null,
            "warmup_seconds": null
