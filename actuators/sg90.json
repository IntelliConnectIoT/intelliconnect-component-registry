        "protocol": "pwm",
        "manufacturer": "Tower Pro",
        "model_number": "SG90",
        "datasheet_url": null,
        "command_topic_suffix": "command/position",
        "response_topic_suffix": "response/position",
        "states": [
            {
                "command": "SET_ANGLE",
                "label": "Set Angle",
                "description": "Set servo position to a specific angle 0-180 degrees. Payload: integer angle value",
                "payload": "{\"angle\": 90}",
                "sort_order": 1,
                "parameter": {
                    "name": "angle",
                    "data_type": "integer",
                    "unit_symbol": "°",
                    "range_min": 0,
                    "range_max": 180,
                    "required": true
                }
            },
            {
                "command": "CENTER",
                "label": "Center",
                "description": "Move servo to center position (90 degrees)",
                "payload": "CENTER",
                "sort_order": 2,
                "parameter": null
            },
            {
                "command": "MIN",
                "label": "Minimum",
                "description": "Move servo to minimum position (0 degrees)",
                "payload": "MIN",
                "sort_order": 3,
                "parameter": null
            },
            {
                "command": "MAX",
                "label": "Maximum",
                "description": "Move servo to maximum position (180 degrees)",
                "payload": "MAX",
                "sort_order": 4,
                "parameter": null
            }
        ]
    },
    "model": {
        "aliases": [
            "sg90"
        ],
        "device_class": "servo"
