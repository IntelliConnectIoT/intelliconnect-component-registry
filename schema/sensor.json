{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://registry.intelliconnect.dev/schema/sensor.json",
    "title": "Sensor entry",
    "type": "object",
    "properties": {
        "key": { "$ref": "common.json#/$defs/key" },
        "kind": { "const": "sensor" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "common.json#/$defs/status" },
        "source": { "type": "string" },
        "vendor": { "$ref": "common.json#/$defs/vendor" },
        "blocked_reason": { "$ref": "common.json#/$defs/nullableString" },
        "platform": {
            "type": "object",
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "sensor_type": { "$ref": "common.json#/$defs/slug" },
                "protocol": { "$ref": "common.json#/$defs/slug" },
                "manufacturer": { "$ref": "common.json#/$defs/nullableString" },
                "model_number": { "type": "string", "minLength": 1 },
                "datasheet_url": { "$ref": "common.json#/$defs/url" },
                "read_interval_seconds": { "type": "integer", "minimum": 1 },
                "readings": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "properties": {
                            "slug": { "$ref": "common.json#/$defs/slug" },
                            "device_class": { "$ref": "common.json#/$defs/nullableString" },
                            "label": { "type": "string", "minLength": 1 },
                            "unit": { "$ref": "common.json#/$defs/nullableString" },
                            "unit_symbol": { "$ref": "common.json#/$defs/nullableString" },
                            "data_type": { "$ref": "common.json#/$defs/dataType" },
                            "range_min": { "$ref": "common.json#/$defs/nullableNumber" },
                            "range_max": { "$ref": "common.json#/$defs/nullableNumber" },
                            "decimal_places": { "$ref": "common.json#/$defs/nullableInteger" },
                            "threshold_warn_low": { "$ref": "common.json#/$defs/nullableNumber" },
                            "threshold_warn_high": { "$ref": "common.json#/$defs/nullableNumber" },
                            "threshold_crit_low": { "$ref": "common.json#/$defs/nullableNumber" },
                            "threshold_crit_high": { "$ref": "common.json#/$defs/nullableNumber" }
                        },
                        "required": ["slug", "device_class", "label", "unit", "unit_symbol", "data_type", "range_min", "range_max", "decimal_places"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["name", "description", "sensor_type", "protocol", "manufacturer", "model_number", "datasheet_url", "read_interval_seconds", "readings"],
            "additionalProperties": false
        },
        "model": {
            "type": "object",
            "properties": {
                "aliases": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            },
            "required": ["aliases"],
            "additionalProperties": false
        },
        "driver": {
            "oneOf": [
                { "$ref": "common.json#/$defs/driver" },
                { "type": "null" }
            ]
        }
    },
    "required": ["key", "kind", "revision", "status", "source", "platform", "model", "driver"],
    "additionalProperties": false
}
