{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://registry.intelliconnect.dev/schema/board.json",
    "title": "Board entry",
    "type": "object",
    "properties": {
        "key": { "$ref": "common.json#/$defs/key" },
        "kind": { "const": "board" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "common.json#/$defs/status" },
        "source": { "type": "string" },
        "platform": {
            "type": "object",
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "board_type": { "type": "string", "minLength": 1 },
                "manufacturer": { "type": "string", "minLength": 1 },
                "model_number": { "type": "string", "minLength": 1 },
                "datasheet_url": { "$ref": "common.json#/$defs/url" },
                "cpu": { "$ref": "common.json#/$defs/nullableString" },
                "ram": { "$ref": "common.json#/$defs/nullableString" },
                "storage": { "$ref": "common.json#/$defs/nullableString" },
                "operating_voltage": { "$ref": "common.json#/$defs/nullableString" },
                "gpio_pins": { "$ref": "common.json#/$defs/nullableInteger" },
                "pwm_channels": { "$ref": "common.json#/$defs/nullableInteger" },
                "adc_channels": { "$ref": "common.json#/$defs/nullableInteger" },
                "dac_channels": { "$ref": "common.json#/$defs/nullableInteger" },
                "dimensions_mm": { "$ref": "common.json#/$defs/nullableString" },
                "weight_g": { "$ref": "common.json#/$defs/nullableNumber" },
                "has_npu": { "type": "boolean" },
                "has_gpu": { "type": "boolean" },
                "has_tpu": { "type": "boolean" },
                "operating_systems": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": { "name": { "type": "string" } },
                        "required": ["name"],
                        "additionalProperties": false
                    }
                },
                "communication_chips": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "chip_model": { "type": "string" },
                            "protocol": { "type": "string" },
                            "standard": { "$ref": "common.json#/$defs/nullableString" }
                        },
                        "required": ["chip_model", "protocol"],
                        "additionalProperties": false
                    }
                },
                "serial_protocols": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "protocol": { "type": "string" },
                            "count": { "type": "integer", "minimum": 0 }
                        },
                        "required": ["protocol", "count"],
                        "additionalProperties": false
                    }
                },
                "interfaces": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "type": { "type": "string" },
                            "count": { "type": "integer", "minimum": 0 }
                        },
                        "required": ["type", "count"],
                        "additionalProperties": false
                    }
                },
                "power": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "source": { "type": "string" },
                            "voltage_min": { "$ref": "common.json#/$defs/nullableNumber" },
                            "voltage_max": { "$ref": "common.json#/$defs/nullableNumber" },
                            "current_max_ma": { "$ref": "common.json#/$defs/nullableInteger" }
                        },
                        "required": ["source"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["name", "description", "board_type", "manufacturer", "model_number", "datasheet_url", "has_npu", "has_gpu", "has_tpu", "operating_systems", "communication_chips", "serial_protocols", "interfaces", "power"],
            "additionalProperties": false
        },
        "harness": {
            "type": "object",
            "properties": {
                "provisioning_model": { "$ref": "common.json#/$defs/provisioningModel" },
                "supported_provisioning_models": {
                    "type": "array",
                    "items": { "$ref": "common.json#/$defs/provisioningModel" },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "component_attachment": { "enum": ["gpio-header", "usb-serial", "none"] },
                "flash": {
                    "type": "object",
                    "properties": {
                        "method": { "enum": ["sd-card", "emmc", "usb-serial", "usb-native", "dfu", "jtag", "vendor-tool"] },
                        "tool": { "$ref": "common.json#/$defs/nullableString" },
                        "port_hint": { "$ref": "common.json#/$defs/nullableString" },
                        "baud": { "$ref": "common.json#/$defs/nullableInteger" },
                        "notes": { "$ref": "common.json#/$defs/nullableString" }
                    },
                    "required": ["method", "tool", "port_hint", "notes"],
                    "additionalProperties": false
                },
                "transport": {
                    "type": "object",
                    "properties": {
                        "network": {
                            "type": "array",
                            "items": { "type": "string" }
                        },
                        "mqtt_client": { "$ref": "common.json#/$defs/nullableString" },
                        "tls": { "type": ["boolean", "null"] },
                        "ota": { "type": ["boolean", "null"] },
                        "notes": { "$ref": "common.json#/$defs/nullableString" }
                    },
                    "required": ["network", "mqtt_client", "tls", "ota"],
                    "additionalProperties": false
                },
                "runtime": {
                    "type": "object",
                    "properties": {
                        "os_family": { "$ref": "common.json#/$defs/nullableString" },
                        "python3": { "type": "boolean" },
                        "package_manager": { "$ref": "common.json#/$defs/nullableString" },
                        "service_manager": { "$ref": "common.json#/$defs/nullableString" }
                    },
                    "required": ["os_family", "python3", "package_manager", "service_manager"],
                    "additionalProperties": false
                },
                "gpio": {
                    "type": "object",
                    "properties": {
                        "library": { "$ref": "common.json#/$defs/nullableString" },
                        "pin_scheme": { "$ref": "common.json#/$defs/nullableString" },
                        "notes": { "$ref": "common.json#/$defs/nullableString" }
                    },
                    "required": ["library", "pin_scheme"],
                    "additionalProperties": false
                },
                "probe": {
                    "type": "object",
                    "properties": {
                        "model_file": { "$ref": "common.json#/$defs/nullableString" },
                        "overlay_file": { "$ref": "common.json#/$defs/nullableString" },
                        "commands": {
                            "type": "array",
                            "items": { "type": "string" }
                        }
                    },
                    "required": ["model_file", "commands"],
                    "additionalProperties": false
                },
                "local_inference": {
                    "type": "object",
                    "properties": {
                        "viable": { "type": ["boolean", "null"] },
                        "accelerator": { "enum": ["cuda", "npu", "gpu", "dsp", "cpu", null] },
                        "usable_memory_gb": { "$ref": "common.json#/$defs/nullableNumber" },
                        "llm": {
                            "type": "object",
                            "properties": {
                                "viable": { "type": ["boolean", "null"] },
                                "max_params_b": { "$ref": "common.json#/$defs/nullableNumber" },
                                "max_model_size_gb": { "$ref": "common.json#/$defs/nullableNumber" },
                                "quantisation": {
                                    "type": "array",
                                    "items": { "type": "string" }
                                },
                                "runtimes": {
                                    "type": "array",
                                    "items": { "type": "string" }
                                },
                                "notes": { "$ref": "common.json#/$defs/nullableString" }
                            },
                            "required": ["viable", "max_params_b", "max_model_size_gb", "quantisation", "runtimes", "notes"],
                            "additionalProperties": false
                        },
                        "tinyml": {
                            "type": "object",
                            "properties": {
                                "viable": { "type": ["boolean", "null"] },
                                "frameworks": {
                                    "type": "array",
                                    "items": { "type": "string" }
                                },
                                "notes": { "$ref": "common.json#/$defs/nullableString" }
                            },
                            "required": ["viable", "frameworks", "notes"],
                            "additionalProperties": false
                        },
                        "notes": { "$ref": "common.json#/$defs/nullableString" }
                    },
                    "required": ["viable", "accelerator", "usable_memory_gb", "llm", "tinyml"],
                    "additionalProperties": false
                },
                "toolchains": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "verified": { "$ref": "common.json#/$defs/verification" }
            },
            "required": ["provisioning_model", "supported_provisioning_models", "component_attachment", "flash", "transport", "runtime", "gpio", "probe", "local_inference", "toolchains", "verified"],
            "additionalProperties": false
        }
    },
    "required": ["key", "kind", "revision", "status", "source", "platform", "harness"],
    "additionalProperties": false
}
